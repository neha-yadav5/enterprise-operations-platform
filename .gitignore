# Repository-wide rules only.
#
# Build output and dependencies belong to whichever package produces them, so
# they live in that package's own .gitignore:
#
#   frontend/.gitignore   Angular and Node artifacts
#   backend/.gitignore    to be added when the backend starts
#
# Keeping them there means a package can be moved or removed without leaving
# orphaned rules behind up here.

# Documentation suite (kept out of the app repo)
/docs

# IDEs and editors
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
.history/

# Logs
*.log

# System files
.DS_Store
Thumbs.db
